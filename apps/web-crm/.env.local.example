# Copiar a .env.local (no commitear). Valores desde Firebase Console / service account.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

RESEND_API_KEY=
# Remitente verificado en Resend. Usado por welcome-email y streak warnings.
WAITLIST_FROM_EMAIL=
WAITLIST_FROM_NAME=T2T Academy

# Cloudflare R2 (almacenamiento de videos y thumbnails de cursos)
# Endpoint S3-compat: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=t2t-courses
# URL pública base del bucket, sin slash final. Ej: https://pub-xxx.r2.dev o https://media.t2t.com
R2_PUBLIC_BASE_URL=

# ============================================================================
# Google Play Billing (validación de compras + RTDN)
# ============================================================================

# Package name de la app Android. Debe coincidir con android.package en
# apps/mobile/app.json.
GOOGLE_PLAY_PACKAGE_NAME=com.t2tacademy.mobile

# Service account JSON de Google Cloud (en base64) con permiso
# "View financial data, orders, and cancellation survey responses" en
# Play Console (Setup > API access). Se decodifica en lib/googlePlay.ts.
# Generar con: `cat sa.json | base64 -w 0`  (o `base64 -b 0 sa.json` en macOS)
GOOGLE_PLAY_SERVICE_ACCOUNT_B64=

# Secret compartido para autenticar push del topic Pub/Sub que recibe RTDN.
# La push subscription de Pub/Sub debe apuntar a:
#   https://<crm-host>/api/billing/google/rtdn?token=<VALOR_DE_ESTA_VAR>
# Generar con: `openssl rand -hex 32`
GOOGLE_PLAY_RTDN_VERIFY_TOKEN=
