# Copiar a .env.local (local) o pegar en Vercel → Settings → Environment Variables.
# No commitear secretos.

# --- Firebase client (CRM UI) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (API routes) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# En Vercel: pegar la private key en UNA linea con \n escapados
# Ej: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=
WAITLIST_FROM_NAME=T2T Academy

# --- Cloudflare R2 (cursos + avatars mobile) ---
# Acepta R2_ACCOUNT_ID o R2_ENDPOINT; R2_BUCKET o R2_BUCKET_NAME
R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=t2t-courses
# R2_BUCKET_NAME=t2t-courses
R2_PUBLIC_BASE_URL=

# --- Google Play Billing (opcional hasta activar tiendas) ---
GOOGLE_PLAY_PACKAGE_NAME=com.t2tacademy.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT_B64=
GOOGLE_PLAY_RTDN_VERIFY_TOKEN=
