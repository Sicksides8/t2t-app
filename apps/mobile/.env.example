# Copiar a .env y completar valores (Expo / Metro)

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# OAuth Client ID tipo Web (NO el Android): en google-services.json → oauth_client con "client_type": 3
# Ejemplo questly-flutter / com.t2tacademy.app: ...-8oqedbuneoseqo18i0jcegffl2dk03fg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Push Expo / EAS (project UUID en expo.dev; tambien en app.json extra.eas.projectId)
EXPO_PUBLIC_EAS_PROJECT_ID=202571bd-feab-43c3-9eb0-ef2a2ce0bc63

# Build iOS en EAS: usar FIREBASE_APP_ID del GoogleService-Info.plist (ios:..., no android:...)

# Opcional: reemplaza el mock del video de bienvenida (URL .mp4 directa)
# EXPO_PUBLIC_WELCOME_VIDEO_URL=

# ============================================================================
# Billing
# ============================================================================
# mock   (default) -> mockBillingProvider en todos los entornos (producción incluida)
# native           -> Google Play (Android) / App Store (iOS) en build EAS nativo
#
# Hasta que Play Console y App Store Connect estén listos, dejar en mock o sin definir.
# Cuando activen tiendas: EXPO_PUBLIC_BILLING_MODE=native en EAS + EXPO_PUBLIC_API_BASE_URL
#
# Expo Go / web siempre usan mock (sin IAP nativo).
