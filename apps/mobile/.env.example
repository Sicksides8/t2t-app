# Copiar a .env y completar valores (Expo / Metro)

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# OAuth Client ID tipo Web (NO el Android): en google-services.json → oauth_client con "client_type": 3
# Ejemplo questly-flutter / com.t2tacademy.app: ...-8oqedbuneoseqo18i0jcegffl2dk03fg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Push Expo / EAS (project UUID en expo.dev; tambien en app.json extra.eas.projectId)
EXPO_PUBLIC_EAS_PROJECT_ID=202571bd-feab-43c3-9eb0-ef2a2ce0bc63

# Build iOS en EAS: usar FIREBASE_APP_ID del GoogleService-Info.plist (ios:..., no android:...)

# Opcional: reemplaza el mock del video de bienvenida (URL .mp4 directa)
# EXPO_PUBLIC_WELCOME_VIDEO_URL=

# ============================================================================
# Billing
# ============================================================================
# Por defecto la app usa mockBillingProvider en todas las plataformas (simula
# cobros sin tocar pasarelas reales — apto para Expo Go, dev builds y demos).
#
# Para activar Google Play Billing real en Android setear esta variable en "1".
# Precondiciones (TODAS deben cumplirse, sino se rompe la compra):
#   1. El build es EAS Build (no Expo Go) con el plugin "expo-iap" en app.json.
#   2. Los SKUs t2t_pro_monthly|yearly y t2t_black_monthly|yearly existen en
#      Google Play Console con offer trial-7d.
#   3. El backend (web-crm) tiene GOOGLE_PLAY_SERVICE_ACCOUNT_B64 +
#      GOOGLE_PLAY_RTDN_VERIFY_TOKEN configurados.
#   4. EXPO_PUBLIC_API_BASE_URL apunta al web-crm desplegado.
# EXPO_PUBLIC_USE_GOOGLE_BILLING=1
